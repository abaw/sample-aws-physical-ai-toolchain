# Drive the arm from an already-published checkpoint. Nothing is trained or scored.
#
# THE EVALUATION GATE IS NOT IN THIS PATH. With run_eval=false nothing has scored this checkpoint in
# this submission, so whatever you point at had better have been scored in another one. Composing the
# stages is what makes the gate an input edge; omitting the stage omits the gate.
#
# Also required: storage_url, checkpoint_url, prepared_dataset_url, lang_instruction, model.vars.
run_prepare="false"
run_train="false"
run_eval="false"
run_hil="true"

# NO model= HERE, deliberately. An example describes which STAGES run; the model is an
# orthogonal choice, and pinning one here made every example run a single-model run — which is how
# a model-specific assertion survived in the shared pipeline until a third model tripped over it.
# Pass `model=<name>` and that model's model.vars on the command line.
# 20 s of driving per interval, one interval per 60 s. The home ramp counts against run_duration_s.
run_duration_s="20"
interval_s="60"
exec_timeout="1h"
