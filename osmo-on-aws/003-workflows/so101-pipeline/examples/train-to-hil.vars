# train -> eval -> HIL, against a dataset that was prepared earlier.
#
# The common shape once conversion is done: it is cached under dataset/<model>/<name>/ and reusing it
# saves re-converting, which for a large recording dominates the chain.
#
# Also required: storage_url, prepared_dataset_url, lang_instruction, and the model's model.vars.
run_prepare=false
run_train=true
run_eval=true
run_hil=true

# NO model= HERE, deliberately. An example describes which STAGES run; the model is an
# orthogonal choice, and pinning one here made every example run a single-model run — which is how
# a model-specific assertion survived in the shared pipeline until a third model tripped over it.
# Pass `model=<name>` and that model's model.vars on the command line.
steps=10
save_freq=10
batch_size=4
# Several trajectories: one lucky trajectory is not convergence. Spaces are fine here —
# submit.sh parses these files rather than word-splitting them.
traj_ids=3 7 11
exec_timeout=24h
