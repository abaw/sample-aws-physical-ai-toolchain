# prepare -> train -> eval -> HIL rehearsal, in one submission.
#
# Stages hand off through `inputs: - task:` edges, so no S3 prefix is pasted between them. Note that
# OSMO round-trips a chained artifact through S3 anyway: this is fewer commands and one less chance to
# paste the wrong prefix, not less transfer.
#
# Still required from you: storage_url, source_dataset_url, dataset_name, lang_instruction, and the
# model's own model.vars. exec_timeout covers the WHOLE chain — a task killed by its timeout publishes
# nothing, so size it for everything you enabled, not for one stage.
run_prepare=true
run_train=true
run_eval=true
run_hil=true

model=gr00t-n17
expected_episodes=43
expected_state_dim=6

# A real fine-tune is 10k-20k steps and hours. This is a wiring test that still produces a loadable
# checkpoint; raise both for a run you intend to trust.
steps=10
save_freq=10
batch_size=4

exec_timeout=24h
