# Values belonging to SmolVLA rather than to a run.
#
#   osmo workflow submit pipeline.yaml --set model=smolvla \
#     $(sed -e '/^#/d' -e '/^$/d' models/smolvla/model.vars | tr '\n' ' ') ...

runtime_image=nvcr.io/nvidia/pytorch:25.04-py3
# SmolVLA's VLM backbone (SmolVLM2-500M) and the smolvla_base checkpoint are both PUBLIC, so no
# credential is needed. Left empty on purpose rather than omitted: the pipeline keys the credential
# block on this being set, so an empty value is how a model says "none".
hf_token_credential=
