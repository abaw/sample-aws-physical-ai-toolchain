# Values belonging to pi0-FAST rather than to a run. Expanded into --set by the user:
#
#   osmo workflow submit pipeline.yaml --set model=pi0fast \
#     $(sed -e '/^#/d' -e '/^$/d' models/pi0fast/model.vars | tr '\n' ' ') ...

# NGC PyTorch: LeRobot resolves CUDA wheels against it, and ffmpeg for torchcodec comes from
# the install script.
runtime_image=nvcr.io/nvidia/pytorch:25.04-py3
# pi0-FAST's text tokenizer is a GATED repo, so an anonymous run gets HTTP 403 at load time.
hf_token_credential=huggingface_token
