# Values that belong to GR00T rather than to a run. Expanded into --set by the user:
#
#   osmo workflow submit pipeline.yaml --set model=gr00t-n17 \
#     $(sed -e '/^#/d' -e '/^$/d' models/gr00t-n17/model.vars | tr '\n' ' ') ...
#
# This file is what keeps "adding a model edits nothing" true for a model that needs a gated
# repository or a base image other than the pipeline's default.

# NGC PyTorch. GR00T's uv.lock resolves against it; a slim python image lacks the CUDA runtime.
runtime_image=nvcr.io/nvidia/pytorch:25.04-py3
# The base model is public, but it pulls its vision-language backbone and processor from a
# separate GATED repository at load time, so an anonymous run dies during model construction.
hf_token_credential=huggingface_token
